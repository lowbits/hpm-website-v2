<article{{ attributes.addClass('node', 'node--job-listing') }}>
  {{ title_prefix }}
  {{ title_suffix }}

  {# 1. Stage Title #}
  <section class="stage-media stage-section">
    <div class="section-container grid grid-cols-1 gap-x-7
                sm:grid-cols-12">
      <div class="flex flex-col items-start gap-3
                  sm:col-span-10 sm:col-start-2
                  lg:col-span-8 lg:col-start-3">
        <h1 class="info text-hpm-red meta-line--red meta-line--medium">
          {{ 'Stellenangebot'|t }}
        </h1>
        <h2 class="h1">{{ label }}</h2>
      </div>
    </div>
  </section>

  {# 2. Stelleninformationen (back link + intro + location/time/level) #}
  {% set loc_labels = [] %}
  {% for loc_item in node.field_job_location %}
    {% if loc_item.entity %}
      {% set loc_labels = loc_labels|merge([loc_item.entity.label]) %}
    {% endif %}
  {% endfor %}
  {% set location_label = loc_labels|join(', ') %}
  {% set levels = [] %}
  {% for item in node.field_experience_level %}
    {% if item.entity %}
      {% set levels = levels|merge([item.entity.label]) %}
    {% endif %}
  {% endfor %}
  {% set level = levels|join(', ') %}
  {% set starting_time = node.field_starting_time.value %}
  {% set intro = node.field_intro_text.value ? node.field_intro_text.value|striptags|trim : '' %}

  {# Fallback: read from job_intro paragraph if node fields are empty #}
  {% if not location_label or not level or not starting_time %}
    {% for item in node.field_paragraphs %}
      {% if item.entity and item.entity.bundle() == 'job_intro' %}
        {% if not location_label and item.entity.field_location.entity %}
          {% set location_label = item.entity.field_location.entity.label %}
        {% endif %}
        {% if not starting_time and item.entity.field_starting_time.value %}
          {% set starting_time = item.entity.field_starting_time.value %}
        {% endif %}
        {% if not level %}
          {% set fallback_lvls = [] %}
          {% for lvl_item in item.entity.field_experience_level %}
            {% if lvl_item.entity %}
              {% set fallback_lvls = fallback_lvls|merge([lvl_item.entity.label]) %}
            {% endif %}
          {% endfor %}
          {% set level = fallback_lvls|join(', ') %}
        {% endif %}
        {% if not intro and item.entity.field_section_title.value %}
          {% set intro = item.entity.field_section_title.value %}
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}

  <section class="content-section">
    <div class="section-container js-element-group
                grid grid-cols-12 gap-y-6 sm:gap-7
                sm:grid-cols-12 sm:gap-y-8
                lg:gap-y-12">

      <div class="col-span-12
                  sm:col-span-10 sm:col-start-2
                  lg:col-span-2 lg:col-start-auto">
        <a class="text-link font-case text-[0.9375rem] leading-[1.2] text-hpm-darkred text-link--back"
           href="{{ internal_urls.stellenangebote }}"
           title="Zu den Stellenangeboten">
          <span class="text-link__text copy">Zur Übersicht</span>
          <span class="link-icon link-icon--back -mt-[1px]">
            {% include '@hpm/images/vectors/button-arrow.svg.twig' %}
          </span>
        </a>
      </div>

      {% if intro %}
        <div class="col-span-12
                    sm:col-span-10 sm:col-start-2
                    lg:col-span-8 lg:col-start-auto">
          <h3 class="quote-small">
            {{ intro }}
          </h3>
        </div>
      {% endif %}

      {% if location_label %}
        <div class="col-span-12 flex flex-col gap-1
                    sm:col-span-3 sm:col-start-2
                    lg:col-span-3 lg:col-start-3">
          <h4 class="info text-hpm-red">Standort</h4>
          <p>{{ location_label }}</p>
        </div>
      {% endif %}

      {% if starting_time %}
        <div class="col-span-12 flex flex-col gap-1
                    sm:col-span-3
                    lg:col-span-3">
          <h4 class="info text-hpm-red">Zeitpunkt</h4>
          <p>{{ starting_time }}</p>
        </div>
      {% endif %}

      {% if level %}
        <div class="col-span-12 flex flex-col gap-1
                    sm:col-span-4
                    lg:col-span-3">
          <h4 class="info text-hpm-red">Level</h4>
          <p>{{ level }}</p>
        </div>
      {% endif %}
    </div>
  </section>

  {# 3. Über Uns – narrative layout with image + overlapping content box #}
  {% if about_us_block %}
    {% set variant_term = node.field_job_image_variant.entity %}
    {% set au_media = variant_term ? variant_term.field_image.entity : about_us_block.field_image.entity %}
    {% set au_image = au_media ? au_media.field_media_image.entity : null %}
    <section class="narrative relative content-section overflow-hidden max-sm:mb-0">
      <div class="section-container max-sm:px-0 grid grid-cols-12 gap-x-5 lg:gap-x-6">
        <div class="relative col-span-12 grid grid-cols-12 gap-x-5 lg:gap-x-6">

          {% if au_image %}
            <div class="col-span-12
                        sm:col-span-11 sm:col-start-2
                        md:col-span-10 md:col-start-3
                        lg:col-span-12 lg:col-start-auto">
              <div class="relative">
                <div class="image-container js-zoom-image" data-delay=".2">
                  <img src="{{ file_url(au_image.uri.value) }}"
                       alt="{{ au_media.field_media_image.alt }}"
                       loading="lazy">
                </div>
                {% if au_media.field_credits.value %}
                  <div class="credits absolute right-[-2px] bottom-0 rotate-90 origin-bottom-right sm:right-[-4px]">
                    {{ au_media.field_credits.value starts with '©' ? au_media.field_credits.value : '© ' ~ au_media.field_credits.value }}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}

          <div class="relative z-[2] col-span-12
                      sm:col-span-10 sm:-top-8
                      lg:absolute lg:-left-8 lg:bottom-8 lg:top-auto lg:w-[41%]">
            <div class="text-white bg-hpm-red js-element-group px-6 py-8 sm:px-8 sm:!py-8">
              {% if about_us_block.field_headline.value %}
                <h2 class="h3 text-white">{{ about_us_block.field_headline.value }}</h2>
              {% endif %}
              {% if about_us_block.field_text.value %}
                <div class="formatted">
                  {{ about_us_block.field_text.value|raw }}
                </div>
              {% endif %}
            </div>
          </div>

        </div>
      </div>
    </section>
  {% endif %}

  {# 4. Ihre Herausforderung #}
  {% if content.field_challenges|render|trim %}
    <section class="content-section">
      <div class="section-container grid grid-cols-1 gap-7
                  sm:grid-cols-12">
        <div class="js-element-group
                    sm:col-span-10 sm:col-start-2
                    md:col-span-8 md:col-start-3
                    lg:col-span-7 lg:col-start-3
                    xl:col-span-6 xl:col-start-3">
          <h2 class="h2 text-hpm-red">{{ 'Ihre Herausforderung'|t }}</h2>
          <div class="formatted">
            {{ content.field_challenges }}
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  {# 5. Ihr Profil #}
  {% if content.field_profile|render|trim %}
    <section class="content-section">
      <div class="section-container grid grid-cols-1 gap-7
                  sm:grid-cols-12">
        <div class="js-element-group
                    sm:col-span-10 sm:col-start-2
                    md:col-span-8 md:col-start-3
                    lg:col-span-7 lg:col-start-3
                    xl:col-span-6 xl:col-start-3">
          <h2 class="h2 text-hpm-red">{{ 'Ihr Profil'|t }}</h2>
          <div class="formatted">
            {{ content.field_profile }}
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  {# 6. Unser Angebot #}
  {% if content.field_offer|render|trim %}
    <section class="content-section">
      <div class="section-container grid grid-cols-1 gap-7
                  sm:grid-cols-12">
        <div class="js-element-group
                    sm:col-span-10 sm:col-start-2
                    md:col-span-8 md:col-start-3
                    lg:col-span-7 lg:col-start-3
                    xl:col-span-6 xl:col-start-3">
          <h2 class="h2 text-hpm-red">{{ 'Unser Angebot'|t }}</h2>
          <div class="formatted">
            {{ content.field_offer }}
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  {# 7. Unsere Benefits #}
  {% if content.field_benefits|render|trim %}
    <section class="content-section">
      <div class="section-container grid grid-cols-1 gap-7
                  sm:grid-cols-12">
        <div class="js-element-group
                    sm:col-span-10 sm:col-start-2
                    md:col-span-8 md:col-start-3
                    lg:col-span-7 lg:col-start-3
                    xl:col-span-6 xl:col-start-3">
          <h2 class="h2 text-hpm-red">{{ 'Unsere Benefits'|t }}</h2>
          <div class="formatted">
            {{ content.field_benefits }}
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  {# 8. Bewerbungsformular #}
  <section class="content-section" data-theme="beige">
    <div class="section-container grid grid-cols-12 gap-y-7 sm:gap-7">
      <div class="col-span-12 sm:col-span-10 sm:col-start-2 md:col-span-8 md:col-start-3 lg:col-span-6 lg:col-start-4">

        <h2 class="h2 text-hpm-red text-center mb-4 sm:mb-6 lg:mb-8">
          {{ 'Bewerben Sie sich'|t }}
        </h2>

        {% include '@hpm/templates/components/application-form.html.twig' with {
          application_title: label|render|striptags|trim,
          job_locations: job_locations|default([])
        } only %}

      </div>
    </div>
  </section>

  {# 9. Kontaktperson – alternate layout with image + contact info #}
  {% if contact_person_block %}
    {% set cp_media = contact_person_block.field_image.entity %}
    {% set cp_image = cp_media ? cp_media.field_media_image.entity : null %}
    <section class="alternate content-section">
      <div class="section-container">
        <div class="grid grid-cols-1 gap-7
                    sm:grid-cols-12
                    md:items-center">

          {# Image #}
          <div class="media--left col-span-12
                      sm:col-span-10 sm:col-start-1
                      md:col-span-6 md:col-start-1">
            {% if cp_image %}
              <div class="image-container js-zoom-image" data-delay=".3">
                <img src="{{ file_url(cp_image.uri.value) }}"
                     alt="{{ contact_person_block.field_name.value }}"
                     loading="lazy">
              </div>
              {% if cp_media.field_credits.value %}
                <div class="credits">
                  <span>{{ cp_media.field_credits.value starts with '©' ? cp_media.field_credits.value : '© ' ~ cp_media.field_credits.value }}</span>
                </div>
              {% endif %}
            {% endif %}
          </div>

          {# Text #}
          <div class="col-span-12 js-element-group
                      sm:col-span-8 sm:col-start-3
                      md:col-span-5 lg:col-span-4
                      md:col-start-8 lg:col-start-8">
            {% if contact_person_block.field_headline.value %}
              <h2 class="font-case text-hpm-darkred font-light text-hpm-red text-[2rem] mb-4">
                {{ contact_person_block.field_headline.value }}
              </h2>
            {% endif %}
            {% if contact_person_block.field_name.value %}
              <h3 class="h4-serif text-hpm-darkred mb-2">
                {{ contact_person_block.field_name.value }}
              </h3>
            {% endif %}
            <div class="formatted">
              {% if contact_person_block.field_job_title.value %}
                <p>{{ contact_person_block.field_job_title.value }}</p>
              {% endif %}
              {% if contact_person_block.field_phone.value %}
                <p>{{ contact_person_block.field_phone.value }}</p>
              {% endif %}
            </div>
          </div>

        </div>
      </div>
    </section>
  {% endif %}

  {# 10. Karte (editable block) #}
  {% if standorte_block %}
    {% set st_media = standorte_block.field_image.entity %}
    {% set st_image = st_media ? st_media.field_media_image.entity : null %}
    {% set st_link = standorte_block.field_link[0] %}
    <section class="map-teaser overflow-hidden js-map" data-theme="blue">
      <div class="section-container grid grid-cols-12 gap-7
                  sm:items-center">

        {# Map image #}
        {% if st_image %}
          <div class="map-teaser__container relative
                      col-span-10 col-start-2
                      sm:col-span-6 sm:col-start-auto sm:order-2 sm:h-[42vw]
                      md:px-10 md:py-0 md:h-[38vw]
                      lg:px-[3rem] lg:h-[30vw]
                      xl:h-156 xl:col-span-6 xl:col-start-6">
            <div class="sm:relative sm:top-1/2 sm:translate-x-[2vw] sm:w-[50vw]
                        md:-translate-y-1/2 md:w-[41vw]
                        lg:w-[36vw]
                        xl:w-full">
              <img src="{{ file_url(st_image.uri.value) }}"
                   alt="{{ standorte_block.field_headline.value ?: 'Standortkarte' }}"
                   loading="lazy">
            </div>
          </div>
        {% endif %}

        {# Content #}
        <div class="js-element-group col-span-12 mt-8
                    sm:col-span-6 sm:mt-0
                    md:col-span-5 md:col-start-2 md:order-1
                    xl:col-span-4">
          {% if standorte_block.field_headline.value %}
            <h2 class="info mb-4 lg:mb-6">
              {{ standorte_block.field_headline.value }}
            </h2>
          {% endif %}
          {% if standorte_block.field_text.value %}
            <p class="quote-small">
              {{ standorte_block.field_text.value|striptags|trim }}
            </p>
          {% endif %}
          {% if st_link and st_link.url %}
            <div class="button-container">
              {% include '@hpm/templates/components/button-link.html.twig' with {
                url: st_link.url.toString(),
                text: st_link.title ?: 'Alle Standorte'|t
              } only %}
            </div>
          {% endif %}
        </div>

      </div>
    </section>
  {% endif %}

  {# 11. Zusätzliche Inhalte (optional paragraphs) #}
  {% if content.field_paragraphs|render|trim %}
    {{ content.field_paragraphs }}
  {% endif %}
</article>
