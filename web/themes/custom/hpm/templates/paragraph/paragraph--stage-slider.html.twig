{#
/**
 * @file
 * Stage slider with art-directed responsive images.
 *
 * Uses <picture> for art direction: portrait crop on mobile,
 * wide landscape on desktop (breakpoint: 60rem / 960px).
 * First slide loads eagerly (LCP), remaining slides lazy-load.
 */
#}
{{ attach_library('hpm/slider-stage') }}
<section{{ attributes.addClass('stage-slider', 'js-stage-slider', 'stage-section', 'overflow-hidden', 'pt-[5.5rem]', 'lg:pt-[7rem]') }}>
  <div class="section-container">
    <div class="stage-slider_slider carousel">
          {% for item in paragraph.field_slides %}
            {% set slide = item.entity %}
            {% set wide_media = slide.field_image.entity %}
            {% set portrait_media = slide.field_image_portrait.entity %}
            {% set caption_text = slide.field_caption.value %}
            {% set is_first = loop.first %}
            <div class="carousel__item stage-slider__item ml-0 w-full cursor-grab">
              <div class="stage-slider__image-box carousel__image-box h-full top-0 left-0 overflow-hidden relative pt-[133.33%] sm:pt-[92%] md:pt-[40%]">
                <picture class="absolute inset-0 block h-full w-full">
                  {% if wide_media %}
                    {% set wide_uri = wide_media.field_media_image.entity.uri.value %}
                    <source media="(min-width: 82rem)"
                            srcset="{{ responsive_srcset(wide_uri, 'stage_landscape', 'lg') }}"
                            type="image/webp">
                    <source media="(min-width: 60rem)"
                            srcset="{{ responsive_srcset(wide_uri, 'stage_landscape', 'md') }}"
                            type="image/webp">
                  {% endif %}
                  {% if portrait_media %}
                    {% set portrait_uri = portrait_media.field_media_image.entity.uri.value %}
                    <source media="(min-width: 45rem)"
                            srcset="{{ responsive_srcset(portrait_uri, 'stage_portrait', 'sm') }}"
                            type="image/webp">
                    {{ responsive_img(portrait_uri, 'stage_portrait', {alt: caption_text, loading: is_first ? 'eager' : 'lazy', fetchpriority: is_first ? 'high' : '', class: 'h-full w-full object-cover'}) }}
                  {% endif %}
                </picture>
              </div>
              {% if caption_text %}
                <p class="caption absolute text-white bottom-4.5 left-5">
                  {{ caption_text }}
                </p>
              {% endif %}
              {% set slide_credits = wide_media.field_credits.value|default(portrait_media.field_credits.value) %}
              {% if slide_credits %}
                <p class="credits absolute origin-bottom-right -right-0.5 bottom-0 rotate-90">
                  {{ slide_credits starts with '©' ? slide_credits : '© ' ~ slide_credits }}
                </p>
              {% endif %}
            </div>
          {% endfor %}
    </div>
    <div class="stage-slider_dots js-stage-dots flex justify-center gap-2 py-3"
         aria-label="Slider navigation"></div>
  </div>
</section>
