{#
/**
 * @file
 * Stage slider item paragraph template.
 */
#}
{% set caption = content.field_caption|render|striptags|trim %}
{% set credits = paragraph.field_image.entity.field_credits.value|default(paragraph.field_image_portrait.entity.field_credits.value) %}
<div class="carousel__item stage-slider__item ml-0 w-full cursor-grab">
  <div class="stage-slider__image-box carousel__image-box h-full top-0 left-0 overflow-hidden relative pt-[133.33%] sm:pt-[92%] md:pt-[40%]">
    {% if paragraph.field_image_portrait.entity %}
      <div class="tall absolute inset-0 h-full w-full md:hidden">
        {{ responsive_picture(paragraph.field_image_portrait.entity.field_media_image.entity.uri.value, 'stage_portrait', {alt: caption, loading: 'lazy', class: 'h-full w-full object-cover'}) }}
      </div>
    {% endif %}
    {% if paragraph.field_image.entity %}
      <div class="wide absolute inset-0 max-md:hidden h-full w-full">
        {{ responsive_picture(paragraph.field_image.entity.field_media_image.entity.uri.value, 'stage_landscape', {alt: caption, loading: 'lazy', class: 'h-full w-full object-cover'}) }}
      </div>
    {% endif %}
  </div>

  {% if caption %}
    <p class="caption absolute opacity-0 text-white bottom-4.5 left-5">
      {{ caption }}
    </p>
  {% endif %}
  {% if credits %}
    <p class="credits absolute opacity-0 text-white bottom-4.5 right-5 text-right">
      {{ credits starts with '©' ? credits : '© ' ~ credits }}
    </p>
  {% endif %}
</div>
