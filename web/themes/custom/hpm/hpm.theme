<?php

/**
 * @file
 * Functions to support theming in the HPM theme.
 */

use Drupal\Core\Url;
use Drupal\image\Entity\ImageStyle;
use Drupal\node\NodeInterface;

/**
 * Implements hook_preprocess() for all templates.
 *
 * Provides internal_url() as a map of path aliases to language-aware URLs.
 */
function hpm_preprocess(&$variables) {
  $paths = [
    'standorte', 'projekte', 'neuigkeiten',
    'kontakt', 'stellenangebote',
  ];
  $urls = [];
  foreach ($paths as $path) {
    $urls[$path] = Url::fromUserInput('/' . $path)->toString();
  }
  $variables['internal_urls'] = $urls;
}

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function hpm_preprocess_html(&$variables) {
  $variables['attributes']['class'][] = 'font-case';
}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 */
function hpm_preprocess_page(&$variables) {
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof NodeInterface) {
    $variables['node_type'] = $node->bundle();
  }

  // Load social media links from the 'social' menu.
  $menu_tree = \Drupal::menuTree();
  $parameters = $menu_tree->getCurrentRouteMenuTreeParameters('social');
  $parameters->setMinDepth(1);
  $parameters->setMaxDepth(1);
  $tree = $menu_tree->load('social', $parameters);
  $manipulators = [
    ['callable' => 'menu.default_tree_manipulators:checkAccess'],
    ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
  ];
  $tree = $menu_tree->transform($tree, $manipulators);

  $social_links = [];
  foreach ($tree as $element) {
    if ($element->link->isEnabled()) {
      $url = $element->link->getUrlObject()->toString();
      $title = $element->link->getTitle();
      $key = mb_strtolower($title);
      $social_links[] = [
        'key' => $key,
        'url' => $url,
        'title' => $title,
      ];
    }
  }
  $variables['social_links'] = $social_links;

  // Load additional navigation links from the 'navigation-additional' menu.
  $parameters = $menu_tree->getCurrentRouteMenuTreeParameters('navigation-additional');
  $parameters->setMinDepth(1);
  $parameters->setMaxDepth(1);
  $tree = $menu_tree->load('navigation-additional', $parameters);
  $tree = $menu_tree->transform($tree, $manipulators);

  $additional_nav = [];
  foreach ($tree as $element) {
    if ($element->link->isEnabled()) {
      $additional_nav[] = [
        'url' => $element->link->getUrlObject()->toString(),
        'title' => $element->link->getTitle(),
      ];
    }
  }
  $variables['additional_nav'] = $additional_nav;
}

/**
 * Implements hook_preprocess_HOOK() for node.html.twig.
 */
function hpm_preprocess_node(&$variables) {
  $node = $variables['node'];
  $variables['node_type'] = $node->bundle();

  // Load reusable block_content entities by info (admin title) for job listings.
  if ($node->bundle() === 'job_listing') {
    $block_map = [
      'about_us_block' => 'about_us',
      'contact_person_block' => 'contact_person',
    ];
    $storage = \Drupal::entityTypeManager()->getStorage('block_content');
    foreach ($block_map as $var_name => $bundle) {
      $blocks = $storage->loadByProperties(['type' => $bundle]);
      if ($blocks) {
        $variables[$var_name] = reset($blocks);
      }
    }
  }

  // Build responsive srcset for project and location images.
  if (in_array($node->bundle(), ['project', 'location'])) {
    $image_field = $node->bundle() === 'project' ? 'field_project_image' : 'field_location_image';
    $variables['hero_srcset'] = _hpm_media_srcset($node, $image_field, 'half');
    if ($node->hasField('field_teaser_image') && !$node->get('field_teaser_image')->isEmpty()) {
      $variables['teaser_srcset'] = _hpm_media_srcset($node, 'field_teaser_image', 'narrow');
    }
  }

  // Build srcset for person portrait images.
  if ($node->bundle() === 'person' && $node->hasField('field_person_image')) {
    $variables['hero_srcset'] = _hpm_media_srcset($node, 'field_person_image', 'portrait');
  }

  // Load centrally managed Karriere block for location pages.
  if ($node->bundle() === 'location') {
    $storage = \Drupal::entityTypeManager()->getStorage('block_content');
    $blocks = $storage->loadByProperties(['type' => 'karriere_standorte']);
    if ($blocks) {
      $block = reset($blocks);
      $variables['karriere_block'] = \Drupal::entityTypeManager()
        ->getViewBuilder('block_content')
        ->view($block);
    }
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for page.html.twig.
 */
function hpm_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof NodeInterface) {
    $suggestions[] = 'page__' . $node->bundle();
  }

  // Add route-based suggestions for system pages and user pages.
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name) {
    $parts = explode('.', $route_name);
    $suggestion = 'page';
    foreach ($parts as $part) {
      $suggestion .= '__' . $part;
      $suggestions[] = $suggestion;
    }
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for node.html.twig.
 */
function hpm_theme_suggestions_node_alter(array &$suggestions, array $variables) {
  $node = $variables['elements']['#node'];
  $view_mode = $variables['elements']['#view_mode'];
  $suggestions[] = 'node__' . $node->bundle() . '__' . $view_mode;
}

/**
 * Implements hook_preprocess_HOOK() for paragraph.html.twig.
 */
function hpm_preprocess_paragraph(&$variables) {
  $paragraph = $variables['paragraph'];
  $variables['paragraph_type'] = $paragraph->bundle();

  // Map field_theme storage values to CSS data-theme values.
  if ($paragraph->hasField('field_theme') && !$paragraph->get('field_theme')->isEmpty()) {
    $theme_map = [
      'dark' => 'darkred',
      'brand' => 'red',
      'beige' => 'beige',
    ];
    $raw = $paragraph->get('field_theme')->value;
    $variables['theme_css'] = $theme_map[$raw] ?? NULL;
  }

  // Provide link data for the reusable button component.
  if ($paragraph->hasField('field_link') && !$paragraph->get('field_link')->isEmpty()) {
    $link = $paragraph->get('field_link')->first();
    $variables['button_url'] = $link->getUrl()->toString();
    $variables['button_text'] = $link->title;
  }

  // Build responsive srcsets for paragraph images rendered via file_url().
  if ($paragraph->hasField('field_image') && !$paragraph->get('field_image')->isEmpty()) {
    $bundle = $paragraph->bundle();
    $type_map = [
      'segments_overview_item' => 'portrait',
      'services_item' => 'half',
      'quote_item' => 'half',
    ];
    if (isset($type_map[$bundle])) {
      $variables['image_srcset'] = _hpm_media_srcset($paragraph, 'field_image', $type_map[$bundle]);
    }
  }

  // Determine delta (position) for segments_item within its parent.
  if ($paragraph->bundle() === 'segments_item') {
    $parent = $paragraph->getParentEntity();
    if ($parent && $parent->hasField('field_items')) {
      foreach ($parent->get('field_items') as $delta => $item) {
        if ((int) $item->target_id === (int) $paragraph->id()) {
          $variables['segment_delta'] = $delta;
          // Even delta (0-indexed) = 2nd, 4th item → beige theme.
          $variables['is_even_item'] = ($delta % 2 === 1);
          break;
        }
      }
    }

    // Build responsive srcset for the hero image.
    $variables['image_srcset'] = _hpm_media_srcset($paragraph, 'field_image', 'wide');

    // Load projects assigned to this Geschäftsfeld via the view.
    if ($paragraph->hasField('field_business_field') && !$paragraph->get('field_business_field')->isEmpty()) {
      $tid = $paragraph->get('field_business_field')->target_id;
      $view = \Drupal\views\Views::getView('projects_by_field');
      if ($view) {
        $view->setArguments([$tid]);
        $view->setDisplay('block_1');
        $view->preExecute();
        $view->execute();
        if (!empty($view->result)) {
          $variables['projects_view'] = $view->buildRenderable('block_1', [$tid]);
        }
      }
    }
  }
}

/**
 * Build srcset and sizes attributes for a media image field.
 *
 * @param \Drupal\Core\Entity\ContentEntityInterface $entity
 *   The entity containing the media reference field.
 * @param string $field_name
 *   The media reference field name.
 * @param string $type
 *   The responsive type: 'wide', 'half', 'narrow', or 'portrait'.
 *
 * @return array|null
 *   Array with 'srcset' and 'sizes' keys, or NULL if no image.
 */
function _hpm_media_srcset($entity, $field_name, $type) {
  if (!$entity->hasField($field_name) || $entity->get($field_name)->isEmpty()) {
    return NULL;
  }
  $media = $entity->get($field_name)->entity;
  if (!$media || !$media->hasField('field_media_image') || $media->get('field_media_image')->isEmpty()) {
    return NULL;
  }
  $file = $media->get('field_media_image')->entity;
  if (!$file) {
    return NULL;
  }
  $uri = $file->getFileUri();

  $styles_map = [
    'wide' => ['max_2600x2600', 'max_1300x1300', 'max_650x650', 'max_325x325'],
    'half' => ['max_2600x2600', 'max_1300x1300', 'max_650x650', 'max_325x325'],
    'narrow' => ['max_1300x1300', 'max_650x650', 'max_325x325'],
    'portrait' => ['max_1300x1300', 'max_650x650', 'max_325x325'],
  ];
  $sizes_map = [
    'wide' => '(min-width: 1290px) 1290px, 100vw',
    'half' => '(min-width: 82rem) 50vw, 100vw',
    'narrow' => '(min-width: 1290px) 325px, (min-width: 851px) 25vw, (min-width: 560px) 50vw, 100vw',
    'portrait' => '(min-width: 82rem) 30vw, (min-width: 60rem) 40vw, 50vw',
  ];

  $widths = [
    'max_2600x2600' => 2600,
    'max_1300x1300' => 1300,
    'max_650x650' => 650,
    'max_325x325' => 325,
  ];

  $srcset_parts = [];
  foreach ($styles_map[$type] as $style_name) {
    $style = ImageStyle::load($style_name);
    if ($style) {
      $style_url = $style->buildUrl($uri);
      $srcset_parts[] = $style_url . ' ' . $widths[$style_name] . 'w';
    }
  }

  return [
    'srcset' => implode(', ', $srcset_parts),
    'sizes' => $sizes_map[$type],
  ];
}
