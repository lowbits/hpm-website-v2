<?php

/**
 * @file
 * Tweaks for HPM: form alterations, views query adjustments.
 */

use Drupal\views\ViewExecutable;
use Drupal\views\Plugin\views\query\Sql;

/**
 * Implements hook_views_query_alter().
 *
 * Sorts job_listings view by minimum experience-level term weight
 * without a relationship join (which causes row duplication for
 * multi-value fields).
 */
function hpm_tweaks_views_query_alter(ViewExecutable $view, Sql $query) {
  if ($view->id() !== 'job_listings') {
    return;
  }

  $db = \Drupal::database();

  // Subquery: minimum term weight per node.
  $sub = $db->select('node__field_experience_level', 'el');
  $sub->join('taxonomy_term_field_data', 'td', 'td.tid = el.field_experience_level_target_id');
  $sub->addField('el', 'entity_id');
  $sub->addExpression('AVG(td.weight)', 'avg_weight');
  $sub->groupBy('el.entity_id');

  // Join the subquery to the main query.
  $def = [
    'table formula' => $sub,
    'field' => 'entity_id',
    'left_table' => 'node_field_data',
    'left_field' => 'nid',
    'type' => 'LEFT',
  ];
  $join = \Drupal::service('plugin.manager.views.join')->createInstance('standard', $def);
  $alias = $query->addRelationship('exp_weight', $join, 'node_field_data');

  // Add the sort: lowest weight first, then by created DESC (already there).
  $query->addOrderBy($alias, 'avg_weight', 'DESC');

  // Move the experience-level sort before the existing created sort.
  $order =& $query->orderby;
  $last = array_pop($order);
  array_unshift($order, $last);
}

/**
 * Implements hook_field_widget_single_element_form_alter().
 *
 * Restricts field_theme options per paragraph type.
 */
function hpm_tweaks_field_widget_single_element_form_alter(&$element, &$form_state, $context) {
  $field_name = $context['items']->getFieldDefinition()->getName();
  if ($field_name !== 'field_theme') {
    return;
  }
  $bundle = $context['items']->getEntity()->bundle();
  $theme_limits = [
    'benefits' => ['weiss', 'beige'],
    'people' => ['weiss', 'beige'],
    'quotes' => ['weiss', 'beige'],
  ];
  if (isset($theme_limits[$bundle])) {
    $allowed = array_flip(array_merge(['_none'], $theme_limits[$bundle]));
    if (isset($element['#options'])) {
      $element['#options'] = array_intersect_key($element['#options'], $allowed);
    }
    elseif (isset($element['value']['#options'])) {
      $element['value']['#options'] = array_intersect_key($element['value']['#options'], $allowed);
    }
  }
}
